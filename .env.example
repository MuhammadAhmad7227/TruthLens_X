# ══════════════════════════════════════════════════════════════════════════════
# TruthLens X — ENVIRONMENT VARIABLE REFERENCE  (.env.example)
# ──────────────────────────────────────────────────────────────────────────────
# This file documents EVERY variable the platform reads. It contains NO real
# credentials and must never be filled in and committed.
#
#   cp .env.example .env && chmod 600 .env      # then edit .env
#
# RULES (see docs/SECURITY_ARCHITECTURE.md §5.3):
#   1. Secrets come from the environment ONLY — never from code, git, or the DB.
#   2. Startup FAILS CLOSED if a critical secret is missing or holds a
#      placeholder value. The service will not boot in a weakened state.
#   3. `.env` is git-ignored. Any secret ever committed is treated as
#      compromised and must be rotated.
#   4. Generate secrets with:  openssl rand -hex 32      (or ./infra/scripts/genkeys.sh)
#
# Status: SPECIFICATION ONLY — no code reads these yet. Delivered in milestone M1.
# Legend:  [CRITICAL] security-sensitive  [REQUIRED] must be set  [optional] has a safe default
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# 1. RUNTIME
# ──────────────────────────────────────────────────────────────────────────────
TLX_ENV=development                     # development | staging | production   [REQUIRED]
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                         # json | console (console is dev-only)
TZ=UTC                                  # MUST stay UTC — timestamps are evidence
REQUEST_ID_HEADER=X-Request-ID
SERVICE_NAME=truthlens
API_HOST=0.0.0.0                        # bind all interfaces (required for container/preview use)
API_PORT=8000
WORKERS=4                               # uvicorn/gunicorn workers per api replica
ENABLE_METRICS=true                     # exposes /metrics — MUST NOT be published by nginx
OTEL_ENABLED=false                      # tracing hooks present, collector not required in v1
OTEL_EXPORTER_OTLP_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────────────
# 2. SECRETS                                                        [CRITICAL]
#    Every one of these must differ between environments. Never reuse dev values.
# ──────────────────────────────────────────────────────────────────────────────
SECRET_KEY=                             # 32+ bytes hex — app-wide HMAC (CSRF, cookie signing)
JWT_PRIVATE_KEY=                        # Ed25519 PEM (EdDSA). RS256 also supported.
JWT_PUBLIC_KEY=                         # Matching public PEM. HS256 is DISALLOWED in production.
JWT_KEY_ID=truthlens-2026-11            # `kid` claim — enables key rotation with overlap
JWT_ISSUER=https://truthlens.example.local
JWT_AUDIENCE=truthlens-web
ACCESS_TOKEN_TTL_SECONDS=900            # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=43200         # 12 hours; rotation with reuse detection
SIGNED_URL_KEY=                         # 32 bytes hex — HMAC for evidence download URLs
SIGNED_URL_TTL_SECONDS=120              # max allowed 900
ENCRYPTION_KEY=                         # NOT USED IN v1 — reserved for the v2 envelope-encryption
                                        # path (ADR-0006 excludes application-level encryption).
                                        # v1 at-rest protection is LUKS2 volume encryption; its key
                                        # custody and escrow are covered in BACKUP_RECOVERY.md §5.
                                        # Still validated as a critical secret in production so the
                                        # v2 migration cannot be blocked by a missing key later.
MFA_ISSUER=TruthLensX

# ──────────────────────────────────────────────────────────────────────────────
# 3. DATABASE — PostgreSQL 16 + pgvector
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://tlx_app:CHANGE_ME@postgres:5432/truthlens
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_ECHO=false                           # true logs SQL — NEVER enable in production (PII)
POSTGRES_DB=truthlens
POSTGRES_USER=tlx_admin                 # bootstrap superuser for the container only
POSTGRES_PASSWORD=                      # [CRITICAL]
# Least-privilege roles created by infra/postgres/initdb (see DATABASE_DESIGN §11)
TLX_DB_ROLE_APP=tlx_app                 # DML only
TLX_DB_ROLE_MIGRATOR=tlx_migrator       # DDL — used only by `alembic upgrade`
TLX_DB_ROLE_WORKER=tlx_worker
TLX_DB_ROLE_AUDITOR=tlx_auditor         # read-only
PGBOUNCER_ENABLED=false
PGBOUNCER_DSN=

# ──────────────────────────────────────────────────────────────────────────────
# 4. REDIS & CELERY
# ──────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_MAX_CONNECTIONS=50
CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/1
CELERY_RESULT_BACKEND=postgresql+psycopg://tlx_worker:CHANGE_ME@postgres:5432/truthlens
                                        # Postgres, NOT Redis — task outcomes are evidentially
                                        # significant and must survive a broker flush.
CELERY_TASK_SERIALIZER=json             # json ONLY — pickle is a remote-code-execution vector
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=4     # overridden to 1 for the GPU queue
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_TASK_TIME_LIMIT=2400
CELERY_TASK_DEFAULT_RETRY_DELAY=30
CELERY_TASK_MAX_RETRIES=3
CELERY_TIMEZONE=UTC
WORKER_MAX_MEMORY_MB=8192               # restart worker above this (contains parser leaks)
GPU_MAX_CONCURRENT_TASKS=1
BEAT_SCHEDULE_ENABLED=true

# ──────────────────────────────────────────────────────────────────────────────
# 5. EVIDENCE STORAGE
# ──────────────────────────────────────────────────────────────────────────────
STORAGE_BACKEND=filesystem              # filesystem | s3   (s3 adapter ships disabled — D-005/D-011)
EVIDENCE_ROOT=/evidence/originals       # WRITE-ONCE. Mounted read-only in every container
                                        # except the ingest worker.
DERIVATIVES_ROOT=/evidence/derivatives
INTAKE_ROOT=/evidence/intake            # transient upload landing zone, aggressively GC'd
QUARANTINE_ROOT=/evidence/quarantine    # rejected / AV-flagged / failed uploads
MODELS_ROOT=/models                     # read-only mount into workers
MODELS_LOCK_FILE=infra/models.lock.json # pins family/version/sha256 of every weight file
ALLOW_MODEL_DOWNLOAD=false              # weights are fetched by script, not at runtime
MODEL_FETCH_VERIFY_CHECKSUM=true        # mismatch ⇒ fail closed, never load

MAX_UPLOAD_BYTES=4294967296             # 4 GiB — nginx client_max_body_size must be >= this
MAX_CHUNK_BYTES=8388608                 # 8 MiB resumable-upload chunk
HASH_BLOCK_BYTES=1048576                # 1 MiB streaming SHA-256 block (bounds RAM)
MERKLE_ENABLED=false                    # per-block Merkle root for very large files (EVID-11)
MERKLE_BLOCK_BYTES=4194304
# ADR-0006: 'disabled' is the ONLY accepted value in v1. Any other value ABORTS startup — the
# envelope-encryption code path does not exist, and a setting that appears to work but does not
# would be a false security claim. At-rest protection is LUKS2 volume encryption (see §19).
EVIDENCE_ENCRYPTION=disabled
INTAKE_RETENTION_HOURS=24
DERIVATIVE_RETENTION_DAYS=90
STORAGE_QUOTA_DEFAULT_BYTES=107374182400    # 100 GiB per case unless overridden
INTEGRITY_SWEEP_SCHEDULE=0 3 * * *          # nightly sweep cron (beat)
INTEGRITY_SWEEP_SAMPLE_PERCENT=100

# S3-compatible backend (only when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET_ORIGINALS=
S3_BUCKET_DERIVATIVES=
S3_ACCESS_KEY_ID=                       # [CRITICAL]
S3_SECRET_ACCESS_KEY=                   # [CRITICAL]
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_OBJECT_LOCK_ENABLED=true             # WORM compliance mode where the provider supports it

# ──────────────────────────────────────────────────────────────────────────────
# 6. UPLOAD VALIDATION & MALWARE SCANNING
# ──────────────────────────────────────────────────────────────────────────────
ALLOWED_MEDIA_TYPES=image/jpeg,image/png,image/tiff,image/webp,video/mp4,video/quicktime,video/x-matroska,audio/wav,audio/mpeg,audio/flac,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/zip,text/plain
                                        # Enforced against MAGIC BYTES, not the client-declared MIME.
ALLOW_ARCHIVE_TYPES=application/zip     # empty to forbid archives entirely
MAX_ARCHIVE_MEMBERS=1000                # zip-bomb guard
MAX_ARCHIVE_UNCOMPRESSED_BYTES=10737418240
ENABLE_AV_SCAN=false                    # ClamAV pre-scan (D-014)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
AV_SCAN_TIMEOUT_SECONDS=300

# ──────────────────────────────────────────────────────────────────────────────
# 7. COMPUTE / DEVICE PREFERENCE
# ──────────────────────────────────────────────────────────────────────────────
DEVICE_PREFERENCE=auto                  # auto | cpu | cuda
CUDA_VISIBLE_DEVICES=0
TORCH_NUM_THREADS=4
OPENCV_NUM_THREADS=4
OMP_NUM_THREADS=4
DETERMINISTIC_MODE=true                 # fixed seeds + deterministic algorithms for reproducibility
RANDOM_SEED_BASE=20260101

# ──────────────────────────────────────────────────────────────────────────────
# 8. LICENCE / FEATURE FLAGS                                    [POLICY-CRITICAL]
#    Defaults produce a PERMISSIVE-ONLY dependency set. See docs/DECISIONS.md
#    D-001/D-002/D-003 and SYSTEM_ARCHITECTURE.md §8 before enabling any of these.
#    Every change is recorded in the audit log.
# ──────────────────────────────────────────────────────────────────────────────
ENABLE_ULTRALYTICS=false                # AGPL-3.0 detector — D-001
ENABLE_AGPL_PYMuPDF=false               # AGPL-3.0 PDF library — D-002 (default: pikepdf/MPL-2.0)
# ADR-0003 / finding L-1: upstream text is contradictory — the LICENSE file contains the full
# GPLv3, while the README states "the same terms as Perl itself (either the Perl Artistic
# License or GPL)". The Artistic election may reduce exposure; that is a legal judgement we do
# not make. Engineering controls hold under EITHER reading: subprocess-isolated, worker image
# only, never linked, and a pure-Python fallback means M8 works with ExifTool entirely absent.
ENABLE_EXIFTOOL=true                    # set false to run pure-Python only — a supported config
EXIFTOOL_BINARY=/usr/bin/exiftool
EXIFTOOL_TIMEOUT_SECONDS=120
ENABLE_POPPLER=false                    # GPL binaries (pdftoppm/pdftotext), subprocess-isolated
ENABLE_ONLINE_GEOCODING=false           # sends coordinates to a third party — D-012
# ADR-0015: DISABLED by default. The dataset licence could not be verified (finding L-7),
# so no gazetteer ships and no place name is resolved until an operator sources and
# licences a dataset themselves. Enabling it REQUIRES a non-empty attribution string —
# startup aborts without one, because every plausible candidate licence requires attribution.
GAZETTEER_ENABLED=false
GAZETTEER_PATH=/models/gazetteer        # offline subset, operator-provisioned — never fetched
GAZETTEER_ATTRIBUTION=                  # REQUIRED if GAZETTEER_ENABLED=true; shown in UI + reports
ENABLE_EXTERNAL_ENRICHMENT=false        # master kill-switch for ALL outbound enrichment

# ──────────────────────────────────────────────────────────────────────────────
# 9. FORENSIC ENGINE DEFAULTS (versioned; per-job overrides are recorded)
# ──────────────────────────────────────────────────────────────────────────────
ELA_DEFAULT_QUALITY=90
ELA_DEFAULT_SCALE=15
PHASH_ALGORITHMS=phash,dhash,ahash,whash
NEAR_DUPLICATE_HAMMING_THRESHOLD=10
DETECTION_CONFIDENCE_THRESHOLD=0.5
DETECTION_IOU_THRESHOLD=0.45
TRACKING_ASSOCIATION=bytetrack          # MIT association logic ported into ai_services (D-001)
ALPR_MIN_CONFIDENCE=0.6
ALPR_TOP_N_CANDIDATES=5
ALPR_JURISDICTION=                      # selects plate_formats rows — D-013 (no default on purpose)
# ADR-0013: HARD DISABLED — setting this to true ABORTS startup in EVERY environment, including
# development. No flag value activates it. The ALPR module contains no HTTP client at all, so the
# prohibition is architectural rather than merely configured. Registry integration is v2 backlog
# and would require a new ADR plus a jurisdictional legal review.
ALPR_ALLOW_REGISTRY_LOOKUP=false
ASR_ENGINE=faster-whisper               # faster-whisper | openai-whisper — D-017
ASR_MODEL_SIZE=base                     # tiny|base|small|medium|large-v3 (GPU recommended for medium+)
ASR_WORD_TIMESTAMPS=true
ASR_LANGUAGE=                           # empty = auto-detect (language + probability are recorded)
DIARIZATION_ENABLED=true
KEYFRAME_INTERVAL_SECONDS=2.0
KEYFRAME_SCENE_CHANGE_THRESHOLD=0.35
MAX_FRAMES_PER_VIDEO=2000
OCR_LANGUAGES=en
OCR_ENGINE=easyocr
DEEPFAKE_ADVISORY_ENABLED=true          # indicators only — NEVER a verdict (PRD §5, DF-01)
DEEPFAKE_REQUIRE_HUMAN_VERIFICATION=true # cannot be disabled by any code path

# ──────────────────────────────────────────────────────────────────────────────
# 10. AI INVESTIGATION ASSISTANT
# ──────────────────────────────────────────────────────────────────────────────
# ADR-0007: the provider is FIXED AT STARTUP. There is no runtime switch, which makes automatic
# cloud fallback structurally impossible — a local failure returns 422 ASSISTANT_UNAVAILABLE and
# the user sees a failure, never a silently substituted external answer.
LLM_PROVIDER=local                      # local | external | stub | null
OLLAMA_BASE_URL=http://ollama:11434     # data network only — never published to a host port
LLM_LOCAL_URL=http://ollama:11434       # Ollama / vLLM endpoint you control
LLM_MODEL=                              # e.g. a locally served instruct model
LLM_PROMPT_TEMPLATE_VERSION=v1.0.0      # logged with EVERY invocation (AI_ARCHITECTURE §4)
# ── ADR-0021: all four below are required before anything can leave the host ──
ENABLE_EXTERNAL_AI=false                # MASTER GATE. Admin activation only; grants expire ≤30 days.
LLM_ALLOW_EXTERNAL_EGRESS=false         # requires ENABLE_EXTERNAL_AI=true, else startup ABORTS
LLM_EGRESS_CONFIRMATION_REQUIRED=true   # false ABORTS startup in production — not negotiable
LLM_EXTERNAL_ALLOWED_CATEGORIES=        # EMPTY by default: enabling AI alone authorises NOTHING.
                                        # Never transmittable under any grant or confirmation:
                                        # original bytes, derivative media, complete case records,
                                        # full metadata dumps, GPS coordinates, plate values, face
                                        # embeddings, secrets, other-case data.
LLM_EXTERNAL_GRANT_MAX_DAYS=30          # enforced by a database CHECK, not just application code
LLM_EXTERNAL_API_KEY=                   # [CRITICAL] SERVER-SIDE ONLY — never a NEXT_PUBLIC_* var
LLM_EXTERNAL_BASE_URL=
LLM_TEMPERATURE=0.0                     # low by design — this is an evidential context
LLM_TOP_P=1.0
LLM_MAX_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=2048
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_RETRIEVAL_TOP_K=12
# Below this score the assistant returns a TEMPLATED REFUSAL WITHOUT CALLING THE MODEL at all
# (ADR-0021 §4.5) — preventing both an ungrounded answer and an unnecessary egress event.
LLM_RETRIEVAL_MIN_SCORE=0.62
LLM_GUARDRAIL_VERSION=1                 # recorded on every message (AI-04)
LLM_ALLOW_EXTERNAL_TOOLS=false          # no tool may reach outside the case scope

# ──────────────────────────────────────────────────────────────────────────────
# 11. AUTHENTICATION POLICY
# ──────────────────────────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_MEMORY_KIB=65536        # 64 MiB (RFC 9106 low-memory first-recommended)
PASSWORD_ARGON2_PARALLELISM=4
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_LOCKOUT_BACKOFF_MULTIPLIER=2
MFA_ENFORCEMENT=admin,lead_investigator # comma-separated roles where TOTP is mandatory — D-018
MFA_TOTP_PERIOD=30
MFA_TOTP_DIGITS=6
SESSION_MAX_PER_USER=10
ADMIN_BREAK_GLASS_ENABLED=false         # admin access to case originals — justification + audit + notify lead
ADMIN_BREAK_GLASS_TTL_MINUTES=30

# ──────────────────────────────────────────────────────────────────────────────
# 12. RATE LIMITS & QUOTAS
# ──────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=10/5m
RATE_LIMIT_REFRESH=60/m
RATE_LIMIT_READ=600/m
RATE_LIMIT_UPLOAD=60/h
RATE_LIMIT_CONTENT_ACCESS=30/m
RATE_LIMIT_ANALYSIS_LAUNCH=100/h
RATE_LIMIT_ASSISTANT=60/h
RATE_LIMIT_REPORT=10/h
MAX_CONCURRENT_JOBS_PER_CASE=20
MAX_CONCURRENT_JOBS_PER_USER=5

# ──────────────────────────────────────────────────────────────────────────────
# 13. WEB / CORS / COOKIES
# ──────────────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://truthlens.example.local
CORS_ALLOWED_ORIGINS=                   # empty = same-origin only (recommended). No wildcards with credentials.
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_HTTPONLY=true
CSRF_ENABLED=true
TRUST_PROXY_HEADERS=true                # only behind your own nginx
HSTS_MAX_AGE=31536000

# ──────────────────────────────────────────────────────────────────────────────
# 14. REPORTS
# ──────────────────────────────────────────────────────────────────────────────
REPORT_TEMPLATE_ROOT=backend/app/reporting/templates
REPORT_FONT_ROOT=backend/app/reporting/fonts    # embedded fonts for deterministic output
REPORT_DETERMINISTIC=true
REPORT_WATERMARK_DEFAULT=DRAFT
REPORT_ENABLE_CRYPTO_SIGNING=false      # requires a signing certificate you procure — D-019
REPORT_SIGNING_CERT_PATH=
REPORT_SIGNING_KEY_PATH=                # [CRITICAL]
REPORT_SIGNING_KEY_PASSWORD=            # [CRITICAL]
REPORT_RETENTION_DAYS=                  # empty = keep for the case lifetime

# ──────────────────────────────────────────────────────────────────────────────
# 15. RETENTION & COMPLIANCE
# ──────────────────────────────────────────────────────────────────────────────
RETENTION_STATUTORY_DAYS=               # ⚠ SET BY YOUR LEGAL COUNSEL — D-020. No default on purpose.
AUDIT_LOG_RETENTION_DAYS=               # empty = never delete (archive after ARCHIVE_AFTER_DAYS)
AUDIT_ARCHIVE_AFTER_DAYS=730
AUDIT_CHAIN_ANCHOR_EXPORT_ENABLED=true  # publish signed chain digests off-host (mitigates T-02)
AUDIT_CHAIN_ANCHOR_PATH=/evidence/anchors
LEGAL_HOLD_DEFAULT=true
CUSTODY_READ_LOGGING=content_reads_only # all_reads | content_reads_only (CUST-06)

# ──────────────────────────────────────────────────────────────────────────────
# 16. ALERTING & NOTIFICATIONS
# ──────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=                          # [CRITICAL]
SMTP_FROM=truthlens@example.local
SMTP_USE_TLS=true
ALERT_EMAILS=
ALERT_WEBHOOK_URL=                      # optional SIEM / Slack sink (SEC-07)
ALERT_WEBHOOK_SECRET=                   # [CRITICAL] HMAC for webhook payloads
ALERT_ON_CHAIN_BREAK=true
ALERT_ON_INTEGRITY_MISMATCH=true
ALERT_ON_AUTH_BURST=true
ALERT_ON_CROSS_CASE_DENIAL_SPIKE=true

# ──────────────────────────────────────────────────────────────────────────────
# 17. FRONTEND (Next.js)
# ──────────────────────────────────────────────────────────────────────────────
# ⚠ The browser must NEVER be told to reach localhost. This value is a RELATIVE
#   path; nginx routes /api to the api service. Hardcoding a host breaks the app
#   behind any proxy or preview environment.
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_WS_BASE=/api/v1
NEXT_PUBLIC_APP_NAME=TruthLens X
NEXT_PUBLIC_ENABLE_ANALYTICS=false      # no third-party analytics on a forensic platform
API_INTERNAL_URL=http://api:8000        # server-side only (Next route handlers)
FRONTEND_PORT=3000

# ──────────────────────────────────────────────────────────────────────────────
# 18. TESTING & CI (never set these in a deployed environment)
# ──────────────────────────────────────────────────────────────────────────────
TESTING=false
CELERY_TASK_ALWAYS_EAGER=false
STUB_ENGINES=true                       # CI runs without model weights (TESTING_STRATEGY §1)
FIXTURE_ROOT=tools/fixtures/generated
TEST_DATABASE_URL=postgresql+psycopg://tlx_app:test@localhost:5432/truthlens_test
TEST_REDIS_URL=redis://localhost:6379/9
PYTEST_ADDOPTS=--strict-markers
COVERAGE_MIN_BACKEND=80
COVERAGE_MIN_FRONTEND=70

# ──────────────────────────────────────────────────────────────────────────────
# 19. HOST PREFLIGHT — encrypted-volume verification (ADR-0006 §5.4)
# ──────────────────────────────────────────────────────────────────────────────
# infra/scripts/verify-encrypted-mount.sh runs BEFORE the application starts and
# REFUSES to start if the expected encrypted volume is absent, is not backed by a
# LUKS2 device, is mounted at the wrong path, has wrong permissions, or resolves
# under a directory served by nginx. A silently unmounted volume would write
# evidence to the unencrypted root filesystem — this check exists to prevent that.
#
# ⚠ Volume encryption protects data AT REST. It does NOT protect against an
#   attacker with access to an already-unlocked, running server. See
#   BACKUP_RECOVERY.md §5.3 — application RBAC and the audit chain are the
#   compensating controls at that layer, and they are different guarantees.
PREFLIGHT_REQUIRED=true                 # MUST be true in production; false ABORTS startup
EVIDENCE_VOLUME_DEVICE=/dev/mapper/truthlens-evidence
EVIDENCE_MOUNT_POINT=/srv/truthlens
NGINX_DOC_ROOT=/usr/share/nginx/html    # asserted NOT to reference EVIDENCE_MOUNT_POINT

# ──────────────────────────────────────────────────────────────────────────────
# 20. WEB / CORS / COOKIES
# ──────────────────────────────────────────────────────────────────────────────
# Empty means SAME-ORIGIN ONLY, which is the recommended posture: the frontend is
# served through nginx from the same origin, so no CORS is needed at all. A
# wildcard is never combined with credentials.
CORS_ALLOWED_ORIGINS=
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_HTTPONLY=true
CSRF_ENABLED=true
TRUST_PROXY_HEADERS=true                # nginx is the only publisher of ports (ADR-0005)
