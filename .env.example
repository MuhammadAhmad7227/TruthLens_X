# TruthLens X environment reference
# M1 application settings use the TLX_ prefix. Never commit real secrets.
TLX_ENVIRONMENT=development
TLX_LOG_LEVEL=INFO
TLX_DATABASE_URL=postgresql+psycopg://tlx:tlx_dev_only@localhost:5432/truthlens
TLX_REDIS_URL=redis://localhost:6379/0
TLX_SECRET_KEY=dev-only-change-me
TLX_CORS_ORIGINS=["http://localhost:3000"]

# Compose bootstrap values
POSTGRES_DB=truthlens
POSTGRES_USER=tlx
POSTGRES_PASSWORD=tlx_dev_only

# Production security:
# - replace TLX_SECRET_KEY with a unique secret
# - use a least-privilege database role
# - never commit .env
